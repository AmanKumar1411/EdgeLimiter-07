# Worker variables for local development. Copy to .dev.vars (or .env) and edit.
# wrangler dev reads them; production values live in wrangler.toml [vars]
# or the Cloudflare dashboard. No secrets are required by EdgeLimiter.

# Comma-separated browser origins allowed to call the API, or "*".
# API auth is header-based (no cookies), so "*" is safe but broad.
CORS_ORIGINS=*

# What /check does when KV or the Durable Object fails:
#   open   → allow and add X-EdgeLimiter-Degraded (default)
#   closed → 503
RATE_LIMIT_FAIL_MODE=open

# Workers AI timeout for the security report (ms). On timeout the report
# falls back to rule-based analysis.
AI_TIMEOUT_MS=8000

# Daily cron deletes security_logs older than N days. Leave unset to keep all.
# SECURITY_LOG_RETENTION_DAYS=30
